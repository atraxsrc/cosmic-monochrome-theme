      "settings": {
        "foreground": "#BDBDBD"
      }
    },
    {
      "name": "Separator",
      "scope": [
        "meta.separator.markdown",
        "punctuation.definition.thematic-break"
      ],
      "settings": {
        "foreground": "#636363"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#CCCCCC"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#DDDDDD"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#AAAAAA"
      }
    },
    {
      "name": "Diff range",
      "scope": [
        "meta.diff.range",
        "meta.diff.header",
        "meta.diff.index"
      ],
      "settings": {
        "foreground": "#A7A7A7"
      }
    },
    {
      "name": "Git commit subject",
      "scope": [
        "meta.scope.message.git-commit",
        "markup.heading.git-commit"
      ],
      "settings": {
        "foreground": "#BDBDBD"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#A7A7A7",
    "type": "#A7A7A7",
    "class": "#A7A7A7",
    "struct": "#A7A7A7",
    "enum": "#A7A7A7",
    "interface": "#A7A7A7",
    "typeParameter": "#A7A7A7",
    "builtinType": "#A7A7A7",
    "function": "#CCCCCC",
    "method": "#CCCCCC",
    "macro": "#DDDDDD",
    "decorator": "#DDDDDD",
    "parameter": {
      "foreground": "#A7A7A7",
      "italic": true
    },
    "variable": "#BDBDBD",
    "property": "#BDBDBD",
    "enumMember": "#BDBDBD",
    "event": "#BDBDBD",
    "label": "#DDDDDD",
    "keyword": "#DDDDDD",
    "selfKeyword": "#DDDDDD",
    "selfParameter": "#DDDDDD",
    "selfTypeKeyword": "#A7A7A7",
    "builtinConstant": "#BDBDBD",
    "lifetime": {
      "foreground": "#DDDDDD",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
