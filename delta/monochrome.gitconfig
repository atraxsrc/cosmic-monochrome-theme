# Monochrome for delta (the git diff pager), part of cosmic-monochrome-theme (MIT).
# Removed lines in the error colour, added lines in the success colour, both
# on the editor's container; changed words on a solid error / success block
# with the editor background as text (the same as DiffAdd / DiffDelete /
# DiffText in Neovim). Code inside the diff uses the bat Monochrome theme, so run
# ./bat/install.sh first.
#
# Install: ./delta/install.sh puts this in ~/.config/delta/, then add to
# ~/.gitconfig (the installer prints this, it never edits ~/.gitconfig):
#   [include]
#       path = ~/.config/delta/monochrome.gitconfig
# and, if delta is not your pager yet:
#   [core]
#       pager = delta
#   [interactive]
#       diffFilter = delta --color-only

[delta]
    features = monochrome

[delta "monochrome"]
    dark = true
    syntax-theme = Monochrome
    navigate = true
    line-numbers = true

    file-style = bold "#AAAAAA"
    file-decoration-style = "#484848" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#484848" box
    hunk-header-file-style = "#A7A7A7"
    hunk-header-line-number-style = "#CCCCCC"

    minus-style = "#DDDDDD" "#1C1C1C"
    minus-emph-style = bold "#111111" "#DDDDDD"
    minus-non-emph-style = "#DDDDDD" "#1C1C1C"
    plus-style = "#CCCCCC" "#1C1C1C"
    plus-emph-style = bold "#111111" "#CCCCCC"
    plus-non-emph-style = "#CCCCCC" "#1C1C1C"
    zero-style = syntax
    whitespace-error-style = "#111111" "#AAAAAA"

    line-numbers-left-style = "#484848"
    line-numbers-right-style = "#484848"
    line-numbers-minus-style = "#DDDDDD"
    line-numbers-plus-style = "#CCCCCC"
    line-numbers-zero-style = "#636363"

    commit-style = bold "#CCCCCC"
    commit-decoration-style = "#484848" box
    blame-palette = "#111111 #1C1C1C #2A2A2A"
    blame-code-style = syntax
    merge-conflict-begin-symbol = ▼
    merge-conflict-end-symbol = ▲
    merge-conflict-ours-diff-header-style = bold "#CCCCCC"
    merge-conflict-theirs-diff-header-style = bold "#AAAAAA"
